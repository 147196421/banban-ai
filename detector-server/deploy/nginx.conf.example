# 后端域名只承载检测服务；ai.banban.plus 直接绑定网站托管方。
# 按服务器实际证书路径调整以下两行。
server {
    listen 443 ssl http2;
    server_name detector.banban.plus;
    ssl_certificate /etc/letsencrypt/live/detector.banban.plus/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/detector.banban.plus/privkey.pem;

    location = /health {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 45s;
    }

    location ^~ /v1/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 45s;
        client_max_body_size 16k;
    }

    location / {
        return 404;
    }
}
