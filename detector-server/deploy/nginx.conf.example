# 同一域名：/v1/ 为本机检测接口，/ 为办办AI网站。
# 先为 ai.banban.plus 配置有效的 TLS 证书。
server {
    listen 443 ssl http2;
    server_name ai.banban.plus;
    ssl_certificate /etc/letsencrypt/live/ai.banban.plus/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai.banban.plus/privkey.pem;

    location = /health {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 45s;
    }

    location ^~ /v1/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 45s;
        client_max_body_size 16k;
    }

    # 前端仍由现有 Sites 托管；Nginx 在自己的域名下反向代理网页与 /api/*。
    location / {
        proxy_pass https://banban-ai.note-entente-0o.chatgpt.site;
        proxy_ssl_server_name on;
        proxy_set_header Host banban-ai.note-entente-0o.chatgpt.site;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 45s;
        proxy_cookie_domain chatgpt.site ai.banban.plus;
        proxy_redirect https://banban-ai.note-entente-0o.chatgpt.site/ https://ai.banban.plus/;
    }
}
